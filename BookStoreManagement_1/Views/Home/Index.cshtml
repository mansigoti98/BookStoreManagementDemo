@{
    ViewData["Title"] = "ABC BookStore Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center mt-5">
    <h2 class="mb-4 text-primary fw-semibold">BookStore</h2>

    <div class="card shadow-lg p-4 rounded-4 bg-light">
        <div class="d-flex flex-column align-items-center gap-3">
            <a asp-controller="Admin" asp-action="Login" class="btn btn-outline-dark px-5 py-2" style="min-width: 220px; font-size: 1.1rem;">
                <i class="bi bi-shield-lock me-2"></i> Admin
            </a>

            <a asp-controller="Customer" asp-action="Login" class="btn btn-outline-success px-5 py-2" style="min-width: 220px; font-size: 1.1rem;">
                <i class="bi bi-person-plus me-2"></i> Customer
            </a>
        </div>
    </div>

</div>
