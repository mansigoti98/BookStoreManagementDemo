@model BookStoreManagement_1.ViewModels.BookFilterViewModel

<div class="container mt-4">
    <!-- Cart Button Top Right -->
    <div style="position: absolute; top: 20px; right: 20px;">
        <a class="btn btn-outline-success btn-sm" style="font-weight: bold; border-radius: 20px; padding: 6px 14px; font-size: 12px;" href="@Url.Action("Cart", "Customer")">
            🛒 View Cart
        </a>
    </div>

    <h2 style="font-size: 1.5rem;">Books</h2>

    <!-- Filter Form -->
    <form asp-action="Shop" method="get" class="mb-4 row g-3">
        <div class="col-md-3">
            <input type="text" name="filterCategory" value="@Model.FilterCategory" placeholder="Category" class="form-control" style="font-size: 12px;" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="minPrice" value="@Model.MinPrice" placeholder="Min Price" class="form-control" style="font-size: 12px;" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="maxPrice" value="@Model.MaxPrice" placeholder="Max Price" class="form-control" style="font-size: 12px;" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm" style="font-size: 12px;">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Shop" class="btn btn-secondary btn-sm" style="font-size: 12px;">Clear</a>
        </div>
    </form>

    <!-- Books Table -->
    <div class="row">
        <table class="table table-bordered table-striped" style="font-size: 13px; width: 100%; border-collapse: collapse;">
            <thead class="table-dark">
                <tr style="font-size: 13px; text-transform: uppercase;">
                    <th style="padding: 8px;">Title</th>
                    <th style="padding: 8px;">Author</th>
                    <th style="padding: 8px;">Category</th>
                    <th style="padding: 8px;">Description</th>
                    <th style="padding: 8px; text-align: right;">Price (₹)</th>
                    <th style="padding: 8px; text-align: center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td style="padding: 8px;">@book.Title</td>
                        <td style="padding: 8px;">@book.Author</td>
                        <td style="padding: 8px;">@book.Category?.CategoryName</td>
                        <td style="padding: 8px;">@book.Description</td>
                        <td style="padding: 8px; text-align: right;">₹@book.Price</td>
                        <td style="padding: 8px; text-align: center;">
                            <form asp-action="AddToCart" method="post">
                                <input type="hidden" name="bookId" value="@book.BookId" />
                                <button type="submit" class="btn btn-outline-primary btn-sm" style="font-size: 11px; padding: 4px 12px; border-radius: 16px;">
                                    + Add
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination and Page Size -->
        <form method="get" asp-action="Shop" class="d-flex align-items-center mb-3">
            <input type="hidden" name="filterCategory" value="@Model.FilterCategory" />
            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
            <input type="hidden" name="page" value="1" />
            <label class="me-2" style="font-size: 12px;">Items per page:</label>
            <select name="pageSize" class="form-select w-auto" onchange="this.form.submit()" style="font-size: 12px;">
                @foreach (var size in new[] { 5, 10, 20, 50 })
                {
                    <option value="@size" selected="@(size == Model.PageSize ? "selected" : null)">@size</option>
                }
            </select>
        </form>

        <!-- Pagination Controls -->
        <nav>
            <ul class="pagination justify-content-center" style="font-size: 12px;">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Shop" asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-filterCategory="@Model.FilterCategory"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">First</a>
                </li>
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Shop" asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-filterCategory="@Model.FilterCategory"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">Previous</a>
                </li>
                <li class="page-item active"><span class="page-link">@Model.CurrentPage</span></li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Shop" asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-filterCategory="@Model.FilterCategory"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">Next</a>
                </li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Shop" asp-route-page="@Model.TotalPages"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-filterCategory="@Model.FilterCategory"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">Last</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
